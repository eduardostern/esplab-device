CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# WAMR: classic interpreter. The fast interpreter's loader overflows its precompiled-code buffer
# with AssemblyScript GC programs on Xtensa (heap corruption in wasm_loader_prepare_bytecode).
CONFIG_WAMR_INTERP_CLASSIC=y
CONFIG_WAMR_INTERP_FAST=n
# no WASI, AOT or app framework (saves flash and RAM)
CONFIG_WAMR_ENABLE_AOT=n
CONFIG_WAMR_ENABLE_LIBC_WASI=n
CONFIG_WAMR_ENABLE_APP_FRAMEWORK=n
# Networking: lean TLS and Wi-Fi buffers, so the program's 64 KiB linear memory still fits.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
# The app runs from app0 (ota_0) like Tasmota; ESP Lab Recovery / Tasmota safeboot sits in factory.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Reproducible builds: no build paths or dates in the image, so anyone can rebuild it bit for bit.
CONFIG_APP_REPRODUCIBLE_BUILD=y
# Small TCP send buffer (2 segments): devices send small frames, and each local-page connection
# would otherwise hold up to 5.7 KB of RAM in flight.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
